# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8787
DB_PATH=../data/lottery.db

# ---------- 管理员 ----------
# 首次启动会用这两项创建管理员账号（数据库里已存在则不再覆盖）
ADMIN_USERNAME=admin
# 留空则首次启动自动生成随机密码并打印到日志（推荐）
ADMIN_PASSWORD=
# 可选：兼容旧客户端的静态令牌，留空表示只用账号密码登录
ADMIN_TOKEN=
# 会话签名密钥；留空会自动生成 data/data-secret.key（chmod 600）
SECRET_KEY=
SESSION_TTL_HOURS=72
# 生产环境走 HTTPS 时设为 true，Cookie 会带 Secure 标记并下发 HSTS
COOKIE_SECURE=false

# ---------- 安全 ----------
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
MIN_PASSWORD_LENGTH=10
# 入站全局限流（每分钟每 IP）
INBOUND_RATE_PER_MIN=240
INBOUND_BURST=60
# 重接口（预测/回测/AI/同步）每分钟每 IP
HEAVY_RATE_PER_MIN=12
# 生产环境填自己的域名，逗号分隔
CORS_ORIGINS=
# 生产环境建议关闭 /api/docs
ENABLE_DOCS=false

# ---------- 行为开关 ----------
READ_ONLY=false
SYNC_ENABLED=true
SYNC_TZ=Asia/Shanghai

# ---------- 数据源 ----------
PROVIDER_PRIMARY=cwl_official
PROVIDER_FALLBACK=c500
RATE_LIMIT_PER_MIN=120
REQUEST_TIMEOUT=20
PAGE_SIZE=300
# 服务器无法直连 cwl.gov.cn 时配置代理
HTTP_PROXY=

# ---------- 预测 ----------
PREDICT_DEFAULT_COUNT=5
PREDICT_MAX_COUNT=100

# ---------- AI ----------
AI_ENABLED=true
AI_TIMEOUT=60
AI_MAX_CALLS_PER_HOUR=30
AI_ALLOW_PUBLIC_SUBMIT=true
# 是否允许供应商 base_url 指向内网 / 本机（默认禁，防 SSRF；用本地 Ollama 时设 true）
AI_ALLOW_PRIVATE_ENDPOINT=false
